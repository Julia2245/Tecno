[Unit]
Description=Telegram Bot Core
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=bot
WorkingDirectory=/opt/telegram-bot
EnvironmentFile=/opt/telegram-bot/.env
ExecStart=/opt/telegram-bot/.venv/bin/python -m app.main
Restart=always
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGINT

# Conservative hardening that does not block normal outbound API calls.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/telegram-bot

[Install]
WantedBy=multi-user.target
