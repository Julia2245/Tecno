# Telegram
BOT_TOKEN=
BOT_DISPLAY_NAME=
SUPER_ADMINS=
DROP_PENDING_UPDATES=false

# PostgreSQL only. Keep credentials outside source control.
DATABASE_URL=postgresql://bot_user:change_me@127.0.0.1:5432/bot_db
PG_POOL_MIN=2
PG_POOL_MAX=20
PG_COMMAND_TIMEOUT=15
TELEGRAM_CONNECTION_LIMIT=100
MAX_CONCURRENT_UPDATES=64

# Runtime
LOG_LEVEL=INFO
SLOW_UPDATE_WARNING_MS=250
